---
const label = 'High contrast';
---

<button class="contrast-toggle" type="button" aria-pressed="false">
  <span class="toggle-icon" aria-hidden="true">◐</span>
  <span class="toggle-label">{label}</span>
</button>

<script>
  const toggle = document.querySelector('.contrast-toggle');
  if (!toggle) {
    throw new Error('High contrast toggle is missing from the page.');
  }

  const savedPreference = localStorage.getItem('site-contrast');
  const prefersHighContrast = window.matchMedia('(prefers-contrast: more)').matches;
  const initialValue = savedPreference === 'high' || (!savedPreference && prefersHighContrast);

  const setContrast = (isHighContrast) => {
    document.documentElement.dataset.contrast = isHighContrast ? 'high' : 'normal';
    toggle.setAttribute('aria-pressed', String(isHighContrast));
    toggle.querySelector('.toggle-label').textContent = isHighContrast
      ? 'Standard contrast'
      : 'High contrast';
  };

  setContrast(initialValue);

  toggle.addEventListener('click', () => {
    const isHighContrast = toggle.getAttribute('aria-pressed') !== 'true';
    setContrast(isHighContrast);
    localStorage.setItem('site-contrast', isHighContrast ? 'high' : 'normal');
  });
</script>

<style>
  .contrast-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
    background: var(--surface);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .contrast-toggle:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .contrast-toggle:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .toggle-icon {
    font-size: 1rem;
  }
</style>
