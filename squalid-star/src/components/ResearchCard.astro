---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  tags: string[];
  status?: string;
}

const { eyebrow, title, description, tags, status } = Astro.props;
---

<article class="research-card">
  <div class="card-topline">
    <p class="eyebrow">{eyebrow}</p>
    {status && <span class="status">{status}</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <ul class="tags" aria-label="Research areas">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>

<style>
  .research-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: clamp(1.35rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: var(--surface);
    box-shadow: 0 1rem 2.5rem rgba(20, 42, 48, 0.05);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .research-card:hover {
    transform: translateY(-0.25rem);
    border-color: var(--accent);
    box-shadow: 0 1.25rem 3rem rgba(20, 42, 48, 0.10);
  }

  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent-strong);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .status {
    flex: none;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    color: var(--accent-strong);
    background: var(--accent-soft);
    font-size: 0.7rem;
    font-weight: 700;
  }

  h3 {
    margin: 0 0 0.8rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 600;
    line-height: 1.15;
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: auto 0 0;
    padding: 1.25rem 0 0;
    list-style: none;
  }

  .tags li {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.75rem;
  }
</style>
